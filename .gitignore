# Local Claude Code settings
.claude/settings.local.json

# One checkout per ticket (`claude --worktree issue-<N>`)
.claude/worktrees/

# Local environment / secrets — never commit.
# List the ones a worktree needs in .worktreeinclude; Claude Code copies them into each new worktree.
.env
.env.*
*.local

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

plugins/sdlc/**/node_modules/
